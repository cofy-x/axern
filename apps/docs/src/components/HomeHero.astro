---
interface Props {
  locale?: 'en' | 'zh-cn';
}

const { locale = 'en' } = Astro.props;
const zh = locale === 'zh-cn';
const base = zh ? '/zh-cn' : '';

import SandboxScene from './SandboxScene.astro';
import HeroBackdrop from './HeroBackdrop.astro';

const escapeHtml = (value: string) => value
  .replaceAll('&', '&amp;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;');

const keywords = new Set([
  'as', 'await', 'const', 'defer', 'from', 'import', 'new', 'print', 'true', 'with',
]);

const highlightLine = (line: string, language: string) => {
  const pattern = language === 'cli'
    ? /(--[\w-]+|'(?:\\.|[^'])*'|\b\d+\b)/g
    : /(\/\/.*$|#.*$|"(?:\\.|[^"])*"|'(?:\\.|[^'])*'|\b(?:as|await|const|defer|from|import|new|print|true|with)\b|\b\d+\b)/g;
  let cursor = 0;
  let result = '';
  for (const match of line.matchAll(pattern)) {
    const index = match.index ?? 0;
    const token = match[0];
    result += escapeHtml(line.slice(cursor, index));
    let type = 'number';
    if (token.startsWith('//') || token.startsWith('#')) type = 'comment';
    else if (token.startsWith('--')) type = 'option';
    else if (token.startsWith('"') || token.startsWith("'")) type = 'string';
    else if (keywords.has(token)) type = 'keyword';
    result += `<span class="ax-token ax-token--${type}">${escapeHtml(token)}</span>`;
    cursor = index + token.length;
  }
  return result + escapeHtml(line.slice(cursor));
};

const highlightCode = (code: string, language: string) => {
  const lines = code.split('\n');
  return {
    gutter: lines
      .map((_, index) => `<span class="ax-code-gutter__line">${index + 1}</span>`)
      .join(''),
    lines: lines
      .map((line) => `<span class="ax-code-line">${highlightLine(line, language) || ' '}</span>`)
      .join(''),
  };
};

const codeExamples = [
  {
    id: 'python',
    label: 'Python',
    language: 'python',
    code: `import os

from axern_sdk import AxernClient, Sandbox

client = AxernClient.from_context(
    os.path.expanduser("~/.config/axern/config.json")
)

with Sandbox(client=client, image="docker.io/library/python:3.12-slim") as sandbox:
    result = sandbox.exec("python -c 'print(42)'", check=True)
    print(result.stdout)`,
  },
  {
    id: 'go',
    label: 'Go',
    language: 'go',
    code: `ctx := context.Background()
client, _ := axern.NewClient(ctx, "127.0.0.1:25000")
defer client.Close()

sandbox, _ := axern.NewSandbox(axern.SandboxOptions{
    Client: client,
    Image: "docker.io/library/python:3.12-slim",
})
defer sandbox.Close(ctx)

_ = sandbox.Start(ctx)
result, _ := sandbox.Exec(ctx, "python -c 'print(42)'", axern.ExecOptions{Check: true})
fmt.Print(result.StdoutString())`,
  },
  {
    id: 'typescript',
    label: 'TypeScript',
    language: 'typescript',
    code: `import { AxernClient, Sandbox } from "@cofy-x/axern-sdk";

const config = process.env.AXERN_CONFIG
  ?? process.env.HOME + "/.config/axern/config.json";
const client = AxernClient.fromContext(config);
const sandbox = await new Sandbox({
  client,
  image: "docker.io/library/python:3.12-slim",
}).start();

const result = await sandbox.exec("python -c 'print(42)'", { check: true });
console.log(result.stdoutText());
await sandbox.close();`,
  },
  {
    id: 'cli',
    label: 'CLI',
    language: 'cli',
    code: `axern local up
axern run python:3.12-slim -- python -c 'print(42)'`,
  },
].map((example) => ({ ...example, highlighted: highlightCode(example.code, example.language) }));
---

<section class="ax-hero">
  <HeroBackdrop />
  <div class="ax-hero__copy">
    <p class="ax-kicker">{zh ? '你的 Agent 系统执行层' : 'THE EXECUTION LAYER FOR YOUR AGENT SYSTEM'}</p>
    <h1
      class="ax-display"
      aria-label={zh ? '面向 AI 智能体的自托管执行平台' : 'Self-hosted execution for AI agents'}
    >
      {zh ? (
        <>
          <span aria-hidden="true">AI 智能体的</span>
          <span class="ax-display__accent" aria-hidden="true">自托管执行平台</span>
        </>
      ) : (
        <>
          <span aria-hidden="true">Self-hosted execution</span>
          <span class="ax-display__accent" aria-hidden="true">for AI agents</span>
        </>
      )}
    </h1>
    <p class="ax-lede">
      {zh
        ? '基于 gVisor 的自托管执行平台，向简单的单机 serving 演进。Agent 规划与协作由你的应用负责。'
        : 'A self-hosted execution platform with gVisor isolation, moving toward simple single-host serving. Agent planning and collaboration stay in your application.'}
    </p>
    <div class="ax-actions">
      <a class="ax-button ax-button--primary" href={`${base}/getting-started/`}>
        {zh ? '快速开始' : 'Quickstart'}
      </a>
      <a class="ax-button" href="https://github.com/cofy-x/axern">
        GitHub ↗
      </a>
    </div>
    <div class="ax-signals not-content" aria-label={zh ? '项目信息' : 'Project signals'}>
      <div class="ax-signal"><span>LICENSE</span><strong>Apache-2.0</strong></div>
      <div class="ax-signal"><span>HOSTING</span><strong>{zh ? '可自托管' : 'Self-hosted'}</strong></div>
      <div class="ax-signal"><span>RUNTIME</span><strong>runsc</strong></div>
      <div class="ax-signal"><span>SDK</span><strong>Python · Go · TypeScript</strong></div>
    </div>
  </div>
  <div class="ax-hero__visual">
    <div class="ax-scene-switch not-content" role="group" aria-label={zh ? '执行模式' : 'Execution mode'}>
      <button
        type="button"
        aria-pressed="true"
        aria-controls="axern-runtime-scene"
        data-scene-mode="AGENT"
      >
        <span>{zh ? '智能体沙箱' : 'Agent Sandbox'}</span>
        <strong>runsc</strong>
      </button>
      <button
        type="button"
        aria-pressed="false"
        aria-controls="axern-runtime-scene"
        data-scene-mode="BATCH"
      >
        <span>{zh ? '并发 Run' : 'Concurrent Runs'}</span>
        <strong>runsc</strong>
      </button>
    </div>
    <SandboxScene />
  </div>
</section>

<section class="ax-section ax-code-section" aria-labelledby="ax-code-heading">
  <div class="ax-section__heading ax-section__heading--compact">
    <p class="ax-eyebrow">{zh ? '从公开 API 开始' : 'START WITH THE PUBLIC API'}</p>
    <h2 id="ax-code-heading">{zh ? '用你已经在用的工具编程沙箱' : 'Program a sandbox with the tools you already use'}</h2>
    <p>{zh ? 'CLI 与三种官方 SDK 共享同一套平台能力；客户端不会用 SSH 或 shell fallback 绕过公开 API。' : 'The CLI and three official SDKs share the same platform capabilities. Clients do not bypass the public API with SSH or shell fallbacks.'}</p>
  </div>
  <div class="ax-code not-content" data-code-tabs>
    <div class="ax-code__toolbar">
      <div class="ax-code__tabs" role="tablist" aria-label={zh ? '代码语言' : 'Code language'}>
        {codeExamples.map((example, index) => (
          <button
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? '0' : '-1'}
            aria-controls={`ax-code-${example.id}`}
            id={`ax-tab-${example.id}`}
            data-code-tab={example.id}
          >
            {example.label}
          </button>
        ))}
      </div>
      <button class="ax-code__copy" type="button" data-copy-code aria-label={zh ? '复制当前代码' : 'Copy current code'}>
        <span data-copy-label>{zh ? '复制' : 'Copy'}</span>
      </button>
    </div>
    {codeExamples.map((example, index) => (
      <div
        class="ax-code__panel"
        id={`ax-code-${example.id}`}
        role="tabpanel"
        aria-labelledby={`ax-tab-${example.id}`}
        data-code-panel={example.id}
        hidden={index !== 0}
      >
        <div class="ax-code__body">
          <div class="ax-code__gutter" aria-hidden="true" set:html={example.highlighted.gutter}></div>
          <pre><code set:html={example.highlighted.lines}></code></pre>
        </div>
      </div>
    ))}
  </div>
</section>

<section class="ax-section ax-section--intro" aria-labelledby="ax-paths-heading">
  <div class="ax-section__heading">
    <p class="ax-eyebrow">{zh ? '从这里开始' : 'START HERE'}</p>
    <h2 id="ax-paths-heading">{zh ? '按你的目标进入文档' : 'Find your path through the docs'}</h2>
    <p>{zh ? '从当前可运行的本地开发栈和 SDK 开始，了解单机服务与持久工作空间的后续方向。' : 'Start with the working local development stack and SDKs, then explore the planned single-host service and persistent workspaces.'}</p>
  </div>
  <div class="ax-workload-grid ax-workload-grid--paths not-content">
    <article>
      <div class="ax-workload-meta">
        <span class="ax-workload-tag">[ QUICKSTART ]</span>
        <span class="ax-workload-index">01 / 04</span>
      </div>
      <h3>{zh ? '运行你的第一个沙箱' : 'Run your first sandbox'}</h3>
      <p>{zh ? '安装 CLI，通过 Docker Compose 启动本地开发栈并执行隔离代码。' : 'Install the CLI, start the local development stack with Docker Compose, and execute isolated code.'}</p>
      <a href={`${base}/getting-started/`}>{zh ? '进入快速开始' : 'Start the quickstart'}</a>
    </article>
    <article>
      <div class="ax-workload-meta">
        <span class="ax-workload-tag">[ SDK ]</span>
        <span class="ax-workload-index">02 / 04</span>
      </div>
      <h3>{zh ? '编程公开 API' : 'Program the public API'}</h3>
      <p>{zh ? '使用 Python、Go 或 TypeScript SDK，与 CLI 共享同一套平台能力。' : 'Use the Python, Go, or TypeScript SDK—same platform capabilities as the CLI, no SSH fallbacks.'}</p>
      <a href={`${base}/sdk/`}>{zh ? '选择 SDK' : 'Choose an SDK'}</a>
    </article>
    <article>
      <div class="ax-workload-meta">
        <span class="ax-workload-tag">[ DIRECTION ]</span>
        <span class="ax-workload-index">03 / 04</span>
      </div>
      <h3>{zh ? '计划中的单机服务' : 'Planned single-host serving'}</h3>
      <p>{zh ? '面向个人 Agent 系统，规划更简单的 Linux 部署、长期沙箱服务与持久 Workspace。' : 'Simpler Linux deployment, long-running sandbox services, and persistent Workspaces for personal agent systems are planned.'}</p>
      <a href="https://github.com/cofy-x/axern/blob/main/docs/decisions/single-host-agent-serving.md">{zh ? '阅读方向决策' : 'Read the direction decision'}</a>
    </article>
    <article>
      <div class="ax-workload-meta">
        <span class="ax-workload-tag">[ OUTPUTS ]</span>
        <span class="ax-workload-index">04 / 04</span>
      </div>
      <h3>{zh ? '交付声明输出' : 'Deliver declared outputs'}</h3>
      <p>{zh ? '在 Run 中声明有限输出，在 runtime 清理前封存，并在输出截止时间前下载保存：清理开始后 15 分钟即过期。' : 'Declare bounded Run outputs, seal them before runtime cleanup, and download them before the output deadline: 15 minutes after cleanup begins.'}</p>
      <a href={`${base}/guides/run/`}>{zh ? '查看 Run 合同' : 'Read the Run contract'}</a>
    </article>
  </div>
</section>

<section class="ax-section ax-open-source" aria-labelledby="ax-open-heading">
  <div>
    <p class="ax-eyebrow">{zh ? '开放构建，明确边界' : 'BUILT IN THE OPEN'}</p>
    <h2 id="ax-open-heading">{zh ? '掌握你的 Agent 执行层' : 'Own your agent execution layer'}</h2>
  </div>
  <div class="ax-open-source__copy">
    <p>{zh ? 'Axern 的控制面、Gateway、节点运行时、CLI 与 SDK 在同一 Apache-2.0 仓库中。你可以运行现有本地开发栈、检查执行契约，并参与以单机为先的产品演进。' : 'Axern keeps its control plane, gateway, node runtime, CLI, and SDKs in one Apache-2.0 repository. Run the existing local development stack, inspect its execution contracts, and contribute to the single-host-first direction.'}</p>
    <div class="ax-actions">
      <a class="ax-button ax-button--primary" href="https://github.com/cofy-x/axern">{zh ? '浏览 GitHub 仓库' : 'Explore the repository'}</a>
      <a class="ax-button" href="https://github.com/cofy-x/axern/blob/main/docs/product/product-direction.md">{zh ? '产品方向' : 'Product direction'}</a>
    </div>
  </div>
</section>

<aside class="ax-maturity" aria-label={zh ? '项目成熟度说明' : 'Project maturity note'}>
  <div>
    <span class="ax-maturity__badge">PRE-1.0</span>
    <strong>{zh ? '当前适合评估与贡献' : 'Ready for evaluation and contribution'}</strong>
  </div>
  <p>{zh ? '专门的单机 serving 部署和持久 Workspace 尚未实现。当前本地路径是 Compose 开发栈，可写存储属于 Allocation，封存输出在清理开始 15 分钟后过期。' : 'Dedicated single-host serving and persistent Workspaces are not implemented yet. The local path is a Compose development stack; writable storage is Allocation-local, and sealed outputs expire 15 minutes after cleanup begins.'}</p>
</aside>

<script>
  document.querySelectorAll<HTMLElement>('[data-code-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-code-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-code-panel]'));
    const copy = root.querySelector<HTMLButtonElement>('[data-copy-code]');
    const copyLabel = root.querySelector<HTMLElement>('[data-copy-label]');
    const defaultCopyLabel = copyLabel?.textContent ?? 'Copy';

    const select = (id: string) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.codeTab === id;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.codePanel !== id; });
    };

    tabs.forEach((tab) => tab.addEventListener('click', () => select(tab.dataset.codeTab ?? 'python')));
    tabs.forEach((tab, index) => tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const offset = event.key === 'ArrowRight' ? 1 : -1;
      const next = tabs[(index + offset + tabs.length) % tabs.length];
      select(next.dataset.codeTab ?? 'python');
      next.focus();
    }));
    copy?.addEventListener('click', async () => {
      const active = root.querySelector<HTMLElement>('[data-code-panel]:not([hidden]) code');
      if (!active || !copyLabel) return;
      await navigator.clipboard.writeText(active.textContent ?? '');
      copyLabel.textContent = document.documentElement.lang.startsWith('zh') ? '已复制' : 'Copied';
      window.setTimeout(() => { copyLabel.textContent = defaultCopyLabel; }, 1600);
    });
  });
</script>
