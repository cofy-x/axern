{
  "name": "@cofy-x/axern-docs",
  "version": "0.4.0",
  "private": true,
  "description": "Official Axern documentation website",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cofy-x/axern.git",
    "directory": "apps/docs"
  },
  "homepage": "https://axern.cofy-x.space",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:content": "pnpm run check && pnpm run lint:markdown && pnpm run check:mermaid && pnpm run check:social-card && pnpm run check:assets",
    "check:links": "node scripts/check-built-links.mjs",
    "check:mermaid": "node scripts/check-mermaid.mjs",
    "check:social-card": "node scripts/generate-social-card.mjs --check",
    "check:assets": "node scripts/check-assets.mjs",
    "generate:social-card": "node scripts/generate-social-card.mjs",
    "lint:markdown": "markdownlint-cli2 \"README.md\" \"src/content/docs/**/*.{md,mdx}\"",
    "test": "pnpm run check:content",
    "lint": "pnpm run check:content",
    "verify": "pnpm run check:content && pnpm run build && pnpm run check:links",
    "deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.5",
    "astro": "7.1.4",
    "astro-mermaid": "2.1.0",
    "mermaid": "11.16.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "jsdom": "28.1.0",
    "markdownlint-cli2": "0.23.2",
    "typescript": "5.9.3",
    "wrangler": "4.114.0"
  }
}
