AXERN_ENDPOINT=REPLACE_ME_GATEWAY_HOST:25000
AXERN_TLS_CA_CERT=REPLACE_ME_PATH/ca.crt
AXERN_TLS_CERT=REPLACE_ME_PATH/client.crt
AXERN_TLS_KEY=REPLACE_ME_PATH/client.key
AXERN_SERVICE_URL=http://REPLACE_ME_GATEWAY_HOST:25080

AXERN_EXAMPLE_NAMESPACE=default
AXERN_EXAMPLE_TEMPLATE_ID=python311
AXERN_EXAMPLE_RUNTIME_CLASS=runsc
AXERN_EXAMPLE_REQUEST_CPU=100m
AXERN_EXAMPLE_REQUEST_MEMORY=128Mi
AXERN_EXAMPLE_LIMIT_CPU=500m
AXERN_EXAMPLE_LIMIT_MEMORY=512Mi
