AXERN_ENDPOINT=REPLACE_ME_GATEWAY_HOST:25000
AXERN_TLS_CA_CERT=REPLACE_ME_PATH/ca.crt
AXERN_TLS_CERT=REPLACE_ME_PATH/client.crt
AXERN_TLS_KEY=REPLACE_ME_PATH/client.key
AXERN_SERVICE_URL=http://REPLACE_ME_GATEWAY_HOST:25080

AXERN_STARTUP_SCENARIO_FILE=REPLACE_ME_PATH/scenarios.json
AXERN_STARTUP_REGISTRY_CREDENTIAL_ID=
AXERN_STARTUP_NAMESPACE=default
AXERN_STARTUP_RUNTIME_CLASS=runsc
AXERN_STARTUP_REQUEST_CPU=100m
AXERN_STARTUP_REQUEST_MEMORY=128Mi
AXERN_STARTUP_LIMIT_CPU=500m
AXERN_STARTUP_LIMIT_MEMORY=512Mi
# Optional placement constraint for controlled per-node diagnostics.
AXERN_STARTUP_NODE_SELECTOR_JSON={}
AXERN_STARTUP_STAGES=1,6,12,24,36
AXERN_STARTUP_ITERATIONS=3
AXERN_STARTUP_PHASES=sandbox,service-fanout,service-replica-scale
AXERN_STARTUP_READY_TIMEOUT_SECONDS=300
AXERN_STARTUP_STAGE_PAUSE_SECONDS=5
AXERN_STARTUP_SCENARIOS=
AXERN_STARTUP_DIRECT_GATEWAY=true
AXERN_STARTUP_PROMETHEUS_URL=
# The benchmark polls until expected stage samples arrive or this timeout
# expires. Keep it comfortably above the 15-second default OTEL interval.
AXERN_STARTUP_METRICS_TIMEOUT_SECONDS=45
AXERN_STARTUP_METRICS_POLL_INTERVAL_SECONDS=1
