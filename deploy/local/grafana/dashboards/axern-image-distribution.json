      "targets": [
        {
          "expr": "sum(rate(dragonfly_client_proxy_request_total{job=\"dragonfly-seed-client\"}[$__rate_interval])) or (0 * sum(up{job=\"dragonfly-seed-client\"}))",
          "legendFormat": "proxy requests",
          "refId": "A"
        },
        {
          "expr": "sum(rate(dragonfly_client_proxy_request_via_dfdaemon_total{job=\"dragonfly-seed-client\"}[$__rate_interval])) or (0 * sum(up{job=\"dragonfly-seed-client\"}))",
          "legendFormat": "served via dfdaemon",
          "refId": "B"
        },
        {
          "expr": "sum(rate(dragonfly_client_backend_request_total{job=\"dragonfly-seed-client\"}[$__rate_interval])) or (0 * sum(up{job=\"dragonfly-seed-client\"}))",
          "legendFormat": "registry backend",
          "refId": "C"
        }
      ],
      "title": "Proxy and Registry Request Rate",
      "type": "timeseries",
      "description": "Compares total proxy traffic, requests served through Dragonfly, and upstream registry requests."
