      "targets": [{
        "expr": "sum by (pod) (rate(dragonfly_client_download_traffic{job=\"dragonfly-seed-client\"}[$__rate_interval])) or (0 * max by (pod) (up{job=\"dragonfly-seed-client\"}))",
        "legendFormat": "{{pod}}",
        "refId": "A"
      }],
      "title": "Distribution Download Throughput",
      "type": "timeseries"
